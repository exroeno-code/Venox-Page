# Client-visible Supabase project URL and publishable key only.
# Never use a service-role or secret key in VITE_* variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Google is enabled by default when Supabase is configured. Set false to hide its sign-in option.
VITE_ENABLE_GOOGLE_AUTH=true

# Server-only NVIDIA credentials for the VEXON Guide (do not prefix with VITE_).
NVIDIA_API_KEY=replace_me
NVIDIA_MODEL=nemotron-3.5-lightning-30b-a3b
